# DevFleet AI Environment Variables & Secrets Configuration

# --- JIRA CONFIGURATION ---
JIRA_DOMAIN=your-jira-domain.atlassian.net
JIRA_PROJECT_KEY=SCRUM
JIRA_USER_EMAIL=your-email@domain.com
JIRA_API_TOKEN=your_jira_api_token_here

# --- GOOGLE CLOUD & GEMINI CONFIGURATION ---
GCP_PROJECT_ID=nexusdev-ai-project
GCP_LOCATION=us-central1
GEMINI_API_KEY=your_gemini_api_key_here

# --- SALESFORCE DX CONFIGURATION ---
SF_DEV_ORG_USERNAME=your-sf-username@domain.com
SF_CONSUMER_KEY=your_salesforce_consumer_key_here
SF_PRIVATE_KEY_PATH=/path/to/server.key

# --- HUMAN APPROVAL ENGINE & RECIPIENT EMAILS ---
APPROVAL_BASE_URL=http://localhost:8000
DECOMPOSER_APPROVER_EMAIL=decomposerEmail@nexusdev.ai
DEVELOPER_APPROVER_EMAIL=developerEmail@nexusdev.ai
RELEASE_APPROVER_EMAIL=releaseEmail@nexusdev.ai


